# FormLaw configuration template. Copy to .env and fill in. Never commit .env.
# The backend reads these; the React app never sees any of them.

# development | test | production   (production refuses to start without the secrets below)
FORMLAW_ENV=development

# PostgreSQL (recommended; docker-compose provides one). Leave empty for a local SQLite file in development.
# DATABASE_URL=postgresql+psycopg://formlaw:CHANGE_ME@localhost:5432/formlaw
DATABASE_URL=

# Signs access tokens. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
COOKIE_SECURE=false

# Encrypts uploaded files at rest (AES-256-GCM). 32 random bytes, base64:
#   python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
FILE_ENCRYPTION_KEY=
STORAGE_DIR=
# S3/MinIO-compatible object storage (adapter not yet implemented; local disk is used)
STORAGE_ENDPOINT=
STORAGE_BUCKET=

# Language models (optional). none = deterministic agents only (no model calls, no cost).
# gemini | openai | anthropic. Other configured providers become automatic fallbacks.
LLM_PROVIDER=none
# Model routing: fast tier (classification, intake) and strong tier (planning, extraction, answers, drafting, judging).
# Empty = provider default (Anthropic: claude-haiku-5-5 / claude-opus-5-5).
LLM_MODEL_FAST=
LLM_MODEL_STRONG=
EMBEDDING_MODEL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Comma-separatedAQ.Ab8RN6K3bbwM7GTrPGtCpRT6P-RIpwGHbwuKlFYyizeT-5AH_Q fallback chain, tried in order when a model is overloaded (429/5xx).
GEMINI_MODEL=gemini-flash-latest,gemini-3.5-flash,gemini-3.1-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Vector search (pgvector lives in DATABASE_URL by default; set only for an external vector DB)
VECTOR_DATABASE_URL=

# KYC provider. "demo" = clearly labelled DEMO VERIFICATION PROVIDER (no real checks).
KYC_PROVIDER=demo
KYC_PROVIDER_KEY=

# Demo personas and the synthetic demo case. Must be false in production.
DEMO_MODE=true

CORS_ORIGINS=http://localhost:5173,http://localhost:5174
MAX_UPLOAD_BYTES=15728640

# Agent run limits (stop runaway loops)
MAX_AGENT_STEPS=40
MAX_RETRIES=2
MAX_REPLANS=3
MAX_TOOL_CALLS=80
MAX_EXECUTION_SECONDS=120
MAX_TOKEN_BUDGET=200000
# Run agents in the request thread (tests). Leave false: runs execute in a worker pool and stream progress over SSE.
RUN_AGENTS_INLINE=false

# Frontend: only needed when the API is not served from the same origin (Vite proxies /api in dev).
VITE_API_URL=
