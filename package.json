{
  "name": "formlaw",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "api": "cd backend && python -m uvicorn app.main:app --reload --port 8000",
    "db:migrate": "cd backend && python -m alembic upgrade head",
    "db:seed": "cd backend && python ../database/seeds/seed.py",
    "test:api": "cd backend && python -m pytest",
    "typecheck": "tsc --noEmit -p .",
    "eval": "python scripts/evaluate.py",
    "test:e2e": "playwright test",
    "test": "npm run typecheck && npm run test:api && npm run test:e2e"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0",
    "three": "0.186.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.0",
    "vite": "^6.1.0"
  }
}
